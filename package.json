{
  "name": "rzero-mail",
  "version": "2.1.2",
  "description": "Serverless Disposable Temp Mail & OTP Receiver with Dynamic Domains, Lock Security, and Live Monitor",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create rzero-db",
    "db:migrate": "wrangler d1 execute rzero-db --file=src/db/schema.sql",
    "db:local": "wrangler d1 execute rzero-db --local --file=src/db/schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.4.0",
    "postal-mime": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250509.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.105.0"
  }
}
